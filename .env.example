# ===== FIREBASE CONFIGURATION =====
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ===== WEATHER & MEDIA SERVICES =====
VITE_WEATHER_API_KEY=
VITE_CLOUDINARY_CLOUD_NAME=

# ===== AI SERVICES CONFIGURATION =====
# Choose your AI provider: 'gemini', 'openai', 'deepseek', or 'none'
VITE_AI_SERVICE_PROVIDER=gemini

# Gemini AI (Google)
VITE_GEMINI_API_KEY=

# OpenAI
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4

# DeepSeek
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_MODEL=deepseek-chat

# ===== BACKEND CONFIGURATION =====
# Set this to your backend server URL for secure AI calls
VITE_API_BASE_URL=http://localhost:3001/api

# Enable/disable AI chat functionality
VITE_ENABLE_AI_CHAT=true

# AI response settings
VITE_AI_MAX_TOKENS=1000
VITE_AI_TEMPERATURE=0.7

# ===== DEVELOPMENT =====
VITE_USE_FIREBASE_EMULATORS=false